<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/toolbar_bg"
            android:elevation="2dp"
            app:contentInsetStart="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/themeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/toggle_theme" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Connection Status Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="0dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/clientCountText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Server Stopped"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fpsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 FPS | 0 KB/s"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Battery --% | --°C"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_description"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="20dp" />

                <!-- Server Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/urlText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Server stopped"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <Button
                                android:id="@+id/toggleButton"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="52dp"
                                android:text="Start Camera Server"
                                android:backgroundTint="@color/accent"
                                android:textColor="#FFFFFF" />

                            <Button
                                android:id="@+id/copyUrlButton"
                                android:layout_width="wrap_content"
                                android:layout_height="52dp"
                                android:layout_marginStart="8dp"
                                android:text="Copy"
                                android:backgroundTint="@color/control_bg"
                                android:textColor="@color/text_primary"
                                android:minWidth="52dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/usbCableStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp"
                            android:text="USB: not connected"
                            android:textColor="@color/text_hint" />

                        <Button
                            android:id="@+id/usbCableModeButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="12dp"
                            android:text="Start Camera USB (Tethering)"
                            android:backgroundTint="@color/control_bg"
                            android:textColor="@color/text_primary"
                            android:enabled="false"
                            android:alpha="0.5" />

                        <!-- QR Code -->
                        <ImageView
                            android:id="@+id/qrCodeImage"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="QR Code" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Camera Controls Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Camera controls"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginBottom="14dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Camera Source"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <Spinner
                            android:id="@+id/cameraSourceSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/switchCameraButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Switch Camera (Back/Front)"
                            android:backgroundTint="@color/control_bg"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/flashButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Flash: OFF"
                            android:backgroundTint="@color/control_bg"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/dimmerButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Screen Dimmer: OFF"
                            android:backgroundTint="@color/control_bg"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zoom"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <SeekBar
                            android:id="@+id/zoomSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JPEG Quality"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <SeekBar
                            android:id="@+id/qualitySeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="50"
                            android:progress="30"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:id="@+id/qualityLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="80%"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp"
                            android:gravity="end"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolution"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <Spinner
                            android:id="@+id/resolutionSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FPS Preset"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <Spinner
                            android:id="@+id/fpsSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Mirror Image (Front Cam)"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <Switch
                                android:id="@+id/mirrorSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="AE/AWB Lock"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <Switch
                                android:id="@+id/aeLockSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Shake to Switch Camera"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <Switch
                                android:id="@+id/shakeSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Orientation Lock"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <Spinner
                            android:id="@+id/orientationSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Brightness / Exposure"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <SeekBar
                            android:id="@+id/exposureSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Settings Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Settings"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_marginBottom="14dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Auto-Start on App Launch"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <Switch
                                android:id="@+id/autoStartSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Server Port"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/portInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="8899"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PIN Protection (leave empty = no PIN)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/pinInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberPassword"
                            android:hint="e.g. 1234"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Watermark Text (optional)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/watermarkInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:hint="e.g. LIVE - MyChannel"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-Stop Timer (minutes, 0 = off)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />
                        <EditText
                            android:id="@+id/timerInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="0"
                            android:textSize="14sp"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button
                                android:id="@+id/exportSettingsButton"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Export Settings"
                                android:backgroundTint="@color/control_bg"
                                android:textColor="@color/text_primary"
                                android:layout_marginEnd="4dp" />
                            <Button
                                android:id="@+id/importSettingsButton"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Import Settings"
                                android:backgroundTint="@color/control_bg"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/hintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:layout_marginBottom="28dp"
                    android:text="Tip: in OBS, set the source Width/Height to match the size shown above to avoid a stretched/square picture." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:text="BroadcastKit v0.1" />

                <TextView
                    android:id="@+id/footerLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:text="Created by: Rian Projects — rianprojects.my.id" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/instagramButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/social_icon_bg"
                        android:padding="9dp"
                        android:src="@drawable/ic_instagram"
                        android:contentDescription="Instagram" />

                    <ImageButton
                        android:id="@+id/tiktokButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/social_icon_bg"
                        android:padding="9dp"
                        android:src="@drawable/ic_tiktok"
                        android:contentDescription="TikTok" />

                    <ImageButton
                        android:id="@+id/websiteButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/social_icon_bg"
                        android:padding="9dp"
                        android:src="@drawable/ic_website"
                        android:contentDescription="Website" />

                    <ImageButton
                        android:id="@+id/githubButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/social_icon_bg"
                        android:padding="9dp"
                        android:src="@drawable/ic_github"
                        android:contentDescription="GitHub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rebuilderLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="72dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Screen Dimmer overlay (full screen, on top) -->
    <View
        android:id="@+id/screenDimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:elevation="100dp" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>
